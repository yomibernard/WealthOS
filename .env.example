# Copy to .env for local development:
#   cp .env.example .env   (or copy on Windows)

DATABASE_URL="file:./dev.db"
DEMO_MODE="true"
SESSION_SECRET="wealthos-mvp-dev-secret-change-in-production"
BASE_CURRENCY="NGN"

# Optional: grounded LLM polish for WealthAI (never invents numbers)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Feature flags (true/false)
FF_PARTNER_EXECUTION=true
FF_WEALTHGUARD_UPLOADS=true
FF_MONTHLY_REPORTS=true
FF_OPEN_BANKING_DEMO=true
FF_HOUSEHOLD=true
FF_PROPERTY_INTEL=true
FF_BUSINESS_INTEL=true
FF_INSURANCE_INTEL=true
FF_PENSION_INTEL=true
FF_WEALTH_INBOX=true
FF_LIFE_EVENT_AUTO=true
FF_ESTATE_LITE=true
FF_ADVISER_COLLAB=true
FF_TAX_LITE=true
FF_CRYPTO_LITE=true
FF_LENDING_LITE=true
FF_WEEKLY_DIGEST=true
# FF_LLM_POLISH defaults to on when OPENAI_API_KEY is set

# WebAuthn / passkeys (Face ID, Touch ID, Windows Hello)
# Must match the host you open in the browser (localhost vs 127.0.0.1 are different RP IDs)
# WEALTHOS_RP_ID=localhost
# WEALTHOS_ORIGIN=http://localhost:3000

# Production / pilot (never commit real values):
# LAUNCH_PROFILE=production
# DEMO_MODE=false
# SESSION_SECRET=<random-32+-chars>
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wealthos?schema=public"
# WEALTHOS_RP_ID=app.yourdomain.com
# WEALTHOS_ORIGIN=https://app.yourdomain.com
